# Copy to .env and fill in. .env is gitignored; never commit real values.

# Public address of the site, no trailing slash. Used for canonical and Open Graph links, robots.txt and sitemap.xml.
# REQUIRED in production. If it is empty, a Vercel deployment uses the address Vercel gives it (fine for previews); locally the fallback
# is http://localhost:3000, which is wrong for a live site.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Payload admin/auth signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Neon Postgres connection strings. Written by `neon link` / `neon deploy` once the
# Neon project exists (see docs/10-payload-cms.md "Neon: set up and verified"). They land in .env.local.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# The name of the Neon branch these two strings belong to (dev, preview or production). `neon checkout <branch>` and `neon env pull --branch <branch>`
# write it. The seed scripts REFUSE to run without it: it is how they know which database they are about to write to.
NEON_BRANCH=dev

# Neon Object Storage (S3-compatible) for the Media collection. When these are empty the
# storage plugin stays off and uploads use the local /media folder.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1

# Shared secret for POST /api/revalidate (clears the cached home page by hand; publishing in the CMS already does it). Without it, every call is refused.
REVALIDATE_SECRET=change-me

# ---- Optional ----

# Which home page sections the live site shows (src/lib/site.ts). Normally left unset: the code holds the current choice (the "courage" section is hidden for now).
#   HOME_SECTION_LIMIT=4             show only the first 4 sections; "all" shows every section (the current default)
#   HOME_HIDDEN_SECTIONS=none        hide none (a comma separated list of section ids hides those)
# The browser checks (`npm run qa:serve`) set both themselves, so the whole page stays tested.
# HOME_SECTION_LIMIT=
# HOME_HIDDEN_SECTIONS=

# Other addresses the ADMIN is opened at, besides the site's own (NEXT_PUBLIC_SITE_URL) and the ones Vercel gives the deployment: comma separated hosts or
# addresses, for example a second domain or a team alias. Payload only accepts a logged-in admin's requests from the listed origins (CSRF protection,
# src/lib/auth-security.ts, docs/10-payload-cms.md "Admin login security"). Symptom of a missing address: the admin logs in and is sent back to the login.
# CSRF_EXTRA_ORIGINS=

# ---- Never put these in a file ----
# They are switches for ONE command, set on that command line, so they cannot be left on by accident (guard: scripts/seed-guard.ts, docs/10-payload-cms.md):
#   SEED_PRODUCTION=1                seed the Neon `production` branch (refused on any other branch, and refused on production without it)
#   SEED_OVERWRITE=1                 replace a page that already has content (this discards what editors wrote)
#   SEED_CONFIRM=overwrite-production    also needed to overwrite on production
# PAYLOAD_MIGRATING=true is set by scripts/vercel-build.mjs and by a production seed. Do not set it by hand.
# QA_URL, QA_PORT and NEXT_DIST_DIR belong to the browser checks (docs/24-qa-suite.md); VERCEL_ENV, VERCEL_URL and CI are set by Vercel and GitHub.
